{
    "name": "api",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "start": "npm run migrate && node dist/index.js",
        "dev": "npm run migrate && tsx watch src/index.ts",
        "test": "jest --detectOpenHandles --runInBand",
        "docker:dev": "docker compose up --build",
        "docker:dev:down": "docker compose down",
        "docker:test": "docker compose -f docker-compose.test.yaml up --build --abort-on-container-exit",
        "docker:test:down": "docker compose -f docker-compose.test.yaml down -v",
        "migrate": "tsx src/scripts/migrate.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.1",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.1",
        "jest": "^30.4.2",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3"
    }
}
